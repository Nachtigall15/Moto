# StockIntel — eigenständige .gitignore (greift nur in diesem Unterprojekt)

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Secrets (API-Keys etc.). Die nicht-geheime config/settings.yaml wird
# bewusst eingecheckt, damit das Deployment (Railway/Docker) die Watchlist
# und Collector-Konfiguration kennt. Secrets gehören ausschließlich in .env.
.env

# Lokale Datenbank / Daten
*.db
*.sqlite
*.sqlite3
# Nur das Laufzeit-Daten-Verzeichnis im Projekt-Root ignorieren (nicht das
# Quellpaket src/stockintel/data/ mit dem Unternehmens-Katalog!).
/data/
:memory:
