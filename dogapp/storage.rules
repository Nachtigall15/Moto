rules_version = '2';

// Fotos zur Gewichtsdokumentation. Gleiche Abwägung wie in
// firestore.rules: anonyme Anmeldung genügt, aber nur unterhalb von
// `haushalte/…` und nur mit Anmeldung.
service firebase.storage {
  match /b/{bucket}/o {
    match /haushalte/{haushalt}/{rest=**} {
      allow read, write: if request.auth != null;
    }
  }
}
